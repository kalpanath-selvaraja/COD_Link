  parcels ||--o{ tracking_events : logs
  parcels ||--o{ delivery_attempts : attempts
  couriers ||--o{ delivery_attempts : performs
  parcels ||--o{ branch_transfers : "moves from"
  parcels ||--o{ branch_transfers : "moves to"
  branches ||--o{ branch_transfers : origin
  branches ||--o{ branch_transfers : destination
  parcels ||--o| cod_collections : generates
  couriers ||--o{ cod_collections : collects
