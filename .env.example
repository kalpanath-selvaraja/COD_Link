# Copy this file to .env and replace these placeholders locally.
spring.datasource.url=jdbc:mysql://localhost:3306/codlink
spring.datasource.username=YOUR_DATABASE_USERNAME
spring.datasource.password=YOUR_DATABASE_PASSWORD
spring.jpa.hibernate.ddl-auto=validate
app.default-admin.username=YOUR_ADMIN_USERNAME
app.default-admin.password=YOUR_ADMIN_PASSWORD
jwt.secret=YOUR_BASE64_ENCODED_SECRET_AT_LEAST_32_BYTES
jwt.expiration=86400000
spring.ai.google.genai.api-key=YOUR_GEMINI_API_KEY
spring.ai.google.genai.chat.model=YOUR_GEMINI_MODEL
